
# En el telefono "localhost" es el propio telefono, no tu computadora. Usa la IP de tu
# computadora en la red Wi-Fi (el telefono y la computadora tienen que estar en la misma):
#   Windows: ipconfig   |   macOS/Linux: ifconfig o ip addr
# Emulador de Android: http://10.0.2.2:8080/api/v1
# Simulador de iOS:    http://localhost:8080/api/v1
EXPO_PUBLIC_API_URL=http://192.168.1.50:8080/api/v1
EXPO_PUBLIC_USE_MOCKS=true